# Copy to .env; never commit the populated file.
PROJECT_NAME="Enterprise AI QA Generator & Assessment Platform"
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""
# Local SQLite is used when DATABASE_URL is empty.
DATABASE_URL=""
# Compose requires a unique DB password and a URL pointing to host postgres.
POSTGRES_PASSWORD=""
DOCKER_DATABASE_URL=""
REDIS_URL="redis://localhost:6379/0"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
# Optional first-admin bootstrap; blank password disables it.
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD=""
